#!/usr/bin/env bash
set -euo pipefail

backup_type="${1:-incr}"
case "$backup_type" in
  full|diff|incr) ;;
  *)
    echo "usage: neurox-backup [full|diff|incr]" >&2
    exit 2
    ;;
esac

pgbackrest --stanza=neurox stanza-create
pgbackrest --stanza=neurox check
pgbackrest --stanza=neurox --type="$backup_type" backup
pgbackrest --stanza=neurox info
