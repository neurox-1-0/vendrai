{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "openapi:export": "cd ../../services/api && .venv/bin/python -m scripts.export_openapi",
    "api:generate": "orval --config orval.config.ts",
    "api:check": "npm run openapi:export && npm run api:generate && git diff --exit-code -- ../../packages/contracts/openapi.json src/generated",
    "e2e": "playwright test --project=setup --project=journeys",
    "e2e:failures": "playwright test --project=failure-injection",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "orval": "8.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5",
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
