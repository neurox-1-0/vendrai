FROM python:3.12.13-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 EASYOCR_MODULE_PATH=/opt/easyocr
WORKDIR /srv/api
RUN apt-get update && apt-get install --yes --no-install-recommends tesseract-ocr libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN addgroup --system neurox && adduser --system --ingroup neurox neurox
COPY services/api/requirements.txt services/api/requirements-document.txt ./
RUN pip install --requirement requirements.txt --requirement requirements-document.txt
RUN python -c "import easyocr; easyocr.Reader(['en'], gpu=False, model_storage_directory='/opt/easyocr', download_enabled=True)"
COPY services/api ./
RUN chown -R neurox:neurox /srv/api
USER neurox
CMD ["python", "-m", "app.workers.document"]
