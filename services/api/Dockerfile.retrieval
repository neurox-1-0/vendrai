# syntax=docker/dockerfile:1.7
FROM python:3.12.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FASTEMBED_CACHE_PATH=/opt/fastembed-cache
WORKDIR /srv/api
RUN addgroup --system neurox && adduser --system --ingroup neurox neurox
COPY services/api/requirements.txt services/api/requirements-retrieval.txt ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --retries 5 --timeout 60 \
        --requirement requirements.txt --requirement requirements-retrieval.txt
# Embedding, sparse, and reranker weights get their own layer, above the
# application code, so editing the retrieval service does not re-download them.
COPY services/api/scripts/download_models.py ./scripts/download_models.py
RUN mkdir -p /opt/fastembed-cache && python -m scripts.download_models retrieval
COPY services/api ./
RUN chown -R neurox:neurox /srv/api /opt/fastembed-cache
USER neurox
CMD ["uvicorn", "app.retrieval_service:app", "--host", "0.0.0.0", "--port", "8100"]
