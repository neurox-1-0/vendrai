# Copy to .env for local development. Replace every CHANGE_ME value.
APP_ENV=development
AUTH_MODE=development

# Database roles are deliberately separate.
NEUROX_MIGRATION_DB_PASSWORD=CHANGE_ME_migration
NEUROX_APP_DB_PASSWORD=CHANGE_ME_app
NEUROX_WORKER_DB_PASSWORD=CHANGE_ME_worker
NEUROX_RELAY_DB_PASSWORD=CHANGE_ME_relay
NEUROX_AUDIT_DB_PASSWORD=CHANGE_ME_audit

RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq
MINIO_ROOT_USER=neurox_storage_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
MINIO_APP_USER=neurox_app_storage
MINIO_APP_PASSWORD=CHANGE_ME_minio_app
MINIO_BACKUP_USER=neurox_backup_storage
MINIO_BACKUP_PASSWORD=CHANGE_ME_minio_backup
PGBACKREST_REPO_CIPHER_PASS=CHANGE_ME_pgbackrest_cipher
KEYCLOAK_ADMIN=neurox_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak
KEYCLOAK_E2E_USER_PASSWORD=CHANGE_ME_keycloak_e2e_user
KEYCLOAK_E2E_CLIENT_SECRET=CHANGE_ME_keycloak_e2e_client
GRAFANA_ADMIN_USER=neurox_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana

UPLOAD_TOKEN_SECRET=CHANGE_ME_at_least_32_random_characters
DATA_ENCRYPTION_SECRET=CHANGE_ME_at_least_32_random_characters
BLIND_INDEX_SECRET=CHANGE_ME_at_least_32_random_characters

# External LLM calls are off by default. Keep them off for real data unless a
# paid, privacy-configured project and the organizational controls are ready.
ALLOW_EXTERNAL_LLM=false
ALLOW_SYNTHETIC_LLM_DATA_ONLY=true
LLM_DATA_CLASSIFICATION=SYNTHETIC
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-3.6-flash

# Official sanctions imports. The EU FSF export may require EU Login; configure
# only an approved official europa.eu URL.
SANCTIONS_MAX_AGE_HOURS=36
SANCTIONS_DOWNLOAD_MAX_BYTES=67108864
SANCTIONS_OFAC_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
SANCTIONS_UN_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
SANCTIONS_EU_URL=

# Generic SMTP. Mailpit requires no credentials and no TLS in local development.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notifications@neurox.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_SSL=false

# Optional self-hosted Langfuse profile (not enabled in base compose).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
